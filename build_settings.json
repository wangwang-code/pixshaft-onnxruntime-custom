{
  "build_abis": [
    "arm64-v8a"
  ],
  "android_min_sdk_version": 24,
  "android_target_sdk_version": 34,
  "build_params": [
    "--android",
    "--parallel",
    "--use_cache",
    "--disable_ml_ops",
    "--no_kleidiai",
    "--enable_lto",
    "--cmake_generator=Ninja",
    "--build_java",
    "--build_shared_lib",
    "--enable_reduced_operator_type_support",
    "--use_xnnpack",
    "--cmake_extra_defines=CMAKE_C_COMPILER_LAUNCHER=ccache",
    "--cmake_extra_defines=CMAKE_CXX_COMPILER_LAUNCHER=ccache",
    "--cmake_extra_defines=CMAKE_CXX_FLAGS_RELEASE=-O3 -DNDEBUG -fno-unroll-loops -fno-asynchronous-unwind-tables",
    "--cmake_extra_defines=onnxruntime_DISABLE_SPARSE_TENSORS=ON",
    "--cmake_extra_defines=onnxruntime_DISABLE_OPTIONAL_TYPE=ON",
    "--cmake_extra_defines=onnxruntime_USE_SVE=OFF",
    "--cmake_extra_defines=onnxruntime_BUILD_UNIT_TESTS=OFF",
    "--cmake_extra_defines=onnxruntime_DEV_MODE=OFF",
    "--cmake_extra_defines=CMAKE_CXX_SCAN_FOR_MODULES=OFF",
    "--cmake_extra_defines=CMAKE_SHARED_LINKER_FLAGS=-Wl,--icf=safe -Wl,-z,max-page-size=16384",
    "--skip_tests"
  ]
}
